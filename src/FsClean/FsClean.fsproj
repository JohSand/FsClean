<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>FS0025</WarningsAsErrors>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- The tool loads the SDK's MSBuild into its own process, so it has to run on a runtime at least as
         new as the SDK a project's global.json picks. A newer preview additionally needs
         DOTNET_ROLL_FORWARD_TO_PRERELEASE=1 in the environment. -->
    <RollForward>LatestMajor</RollForward>
    <!-- The compiler service allocates heavily for minutes. Server GC's larger budgets nearly halve a run
         (120s against 224s on a 66k-line, 18-project solution) for about 0.8 GB more memory; runtimeconfig.template.json
         caps it at a few heaps, which keeps small machines fine. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>

    <FSharpCoreVersion Condition="'$(FSharpCoreVersion)' == ''">10.1.201</FSharpCoreVersion>
    <!-- For code that needs the F# 11 preview compiler, build with
         -p:FcsVersion=43.13.101-rc1.26425.128 -p:FSharpCoreVersion=11.0.101-rc1.26425.128 -->
    <DefineConstants Condition="'$(FcsVersion)' != ''">$(DefineConstants);FCS_11</DefineConstants>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsclean</ToolCommandName>
    <PackageId>FsClean</PackageId>
    <Description>Finds and removes dead code, and unneeded project references, in F# projects.</Description>
    <!-- The release workflow overrides this with the version from the tag. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>JohSand</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fsharp;dead-code;unused-code;refactoring;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/JohSand/FsClean</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JohSand/FsClean</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Memory.fs" />
    <Compile Include="Ast.fs" />
    <Compile Include="ProjectLoader.fs" />
    <Compile Include="References.fs" />
    <Compile Include="Analysis.fs" />
    <Compile Include="Removal.fs" />
    <Compile Include="Diff.fs" />
    <Compile Include="Fix.fs" />
    <Compile Include="Opens.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ionide.ProjInfo.FCS" Version="0.75.0" />
    <!-- The compiler service must be at least as new as the F# the analyzed code was written for.
         Ionide.ProjInfo.FCS brings 43.12.201, which needs this exact FSharp.Core. A build for newer code
         swaps both, see FcsVersion below. -->
    <PackageReference Include="FSharp.Core" Version="$(FSharpCoreVersion)" />
    <PackageReference Include="FSharp.Compiler.Service" Version="$(FcsVersion)" Condition="'$(FcsVersion)' != ''" />
    <!-- Compile-time only: ProjectLoader evaluates the projects with the SDK's own MSBuild, which is
         what Ionide.ProjInfo registers at runtime. Copying MSBuild next to the tool would shadow it. -->
    <PackageReference Include="Microsoft.Build" Version="18.9.6" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
