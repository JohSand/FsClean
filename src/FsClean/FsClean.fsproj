<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>FS0025</WarningsAsErrors>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsclean</ToolCommandName>
    <PackageId>FsClean</PackageId>
    <Description>Finds and removes dead code, and unneeded project references, in F# projects.</Description>
    <!-- The release workflow overrides this with the version from the tag. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>JohSand</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fsharp;dead-code;unused-code;refactoring;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/JohSand/FsClean</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JohSand/FsClean</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Ast.fs" />
    <Compile Include="ProjectLoader.fs" />
    <Compile Include="References.fs" />
    <Compile Include="Analysis.fs" />
    <Compile Include="Removal.fs" />
    <Compile Include="Fix.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ionide.ProjInfo.FCS" Version="0.75.0" />
    <!-- FCS 43.12.201 requires this exact FSharp.Core; the SDK's implicit reference is newer. -->
    <PackageReference Include="FSharp.Core" Version="10.1.201" />
    <!-- Compile-time only: ProjectLoader evaluates the projects with the SDK's own MSBuild, which is
         what Ionide.ProjInfo registers at runtime. Copying MSBuild next to the tool would shadow it. -->
    <PackageReference Include="Microsoft.Build" Version="18.9.6" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
